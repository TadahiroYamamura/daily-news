{
  "permissions": {
    "allow": [
      "Bash(python3 scripts/fetch_sources.py)",
      "Bash(python3 scripts/render_digest.py)",
      "Bash(git add digests/*)",
      "Bash(git add archive/*)",
      "Bash(git commit -m *)",
      "Bash(git log --oneline)",
      "Bash(git status)",
      "Bash(git show)",
      "Bash(scripts/post_digest_issue.sh *)",
      "Bash(scripts/gh.sh issue list *)",
      "Bash(scripts/gh.sh issue view *)",
      "Bash(scripts/gh.sh issue comment *)",
      "Bash(python3 scripts/archive_index.py *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(.env)",
      "Edit(.env)",
      "Write(.env)",
      "Bash(cat .env)",
      "Bash(cat *.env)",
      "Bash(head .env)",
      "Bash(grep * .env)"
    ]
  }
}
